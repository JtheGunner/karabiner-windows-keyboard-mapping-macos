{
  "title": "Win-keys \u00b7 16 \u00b7 Finder cut (Ctrl+X moves on Ctrl+V, Esc cancels)  [order before group 10]",
  "rules": [
    {
      "description": "Finder: Ctrl+X => Cmd+C (Finder has no cut; remember to move on paste)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "finder_renaming",
              "value": 1
            }
          ],
          "from": {
            "key_code": "x",
            "modifiers": {
              "mandatory": [
                "left_control"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "finder_cut_pending",
                "value": 1
              }
            },
            {
              "key_code": "c",
              "modifiers": [
                "left_command"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Finder: Ctrl+V after Ctrl+X => Cmd+Opt+V (move the cut items here)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "finder_renaming",
              "value": 1
            },
            {
              "type": "variable_if",
              "name": "finder_cut_pending",
              "value": 1
            }
          ],
          "from": {
            "key_code": "v",
            "modifiers": {
              "mandatory": [
                "left_control"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "v",
              "modifiers": [
                "left_command",
                "left_option"
              ]
            },
            {
              "set_variable": {
                "name": "finder_cut_pending",
                "value": 0
              }
            }
          ]
        }
      ]
    },
    {
      "description": "Finder: Ctrl+C => Cmd+C (forgets a pending cut so the next paste copies)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "finder_renaming",
              "value": 1
            }
          ],
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": [
                "left_control"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "finder_cut_pending",
                "value": 0
              }
            },
            {
              "key_code": "c",
              "modifiers": [
                "left_command"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Finder: Escape after Ctrl+X => Escape (cancel the pending cut)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "finder_renaming",
              "value": 1
            },
            {
              "type": "variable_if",
              "name": "finder_cut_pending",
              "value": 1
            }
          ],
          "from": {
            "key_code": "escape",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            },
            {
              "set_variable": {
                "name": "finder_cut_pending",
                "value": 0
              }
            }
          ]
        }
      ]
    }
  ]
}
