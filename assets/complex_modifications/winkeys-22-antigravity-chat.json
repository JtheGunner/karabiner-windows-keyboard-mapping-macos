{
    "title": "Win-keys \u00b7 22 \u00b7 Antigravity agent chat (Ctrl+A / C / Z / Y)",
    "rules": [
        {
            "description": "Antigravity agent chat: Ctrl+A => Cmd+A, Ctrl+C => Ctrl+Insert, Ctrl+Z => Cmd+Z, Ctrl+Y => Cmd+Shift+Z (the chat swallows or misroutes these; the IDE keymap sends them on as ^A / ^C / ^Z / ^Y in the terminal)",
            "manipulators": [
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.google\\.antigravity$",
                                "^com\\.google\\.antigravity-ide$"
                            ]
                        }
                    ],
                    "from": {
                        "key_code": "a",
                        "modifiers": {
                            "mandatory": [
                                "left_control"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "a",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.google\\.antigravity$",
                                "^com\\.google\\.antigravity-ide$"
                            ]
                        }
                    ],
                    "from": {
                        "key_code": "c",
                        "modifiers": {
                            "mandatory": [
                                "left_control"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "insert",
                            "modifiers": [
                                "left_control"
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.google\\.antigravity$",
                                "^com\\.google\\.antigravity-ide$"
                            ]
                        }
                    ],
                    "from": {
                        "key_code": "y",
                        "modifiers": {
                            "mandatory": [
                                "left_control"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "y",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.google\\.antigravity$",
                                "^com\\.google\\.antigravity-ide$"
                            ]
                        }
                    ],
                    "from": {
                        "key_code": "z",
                        "modifiers": {
                            "mandatory": [
                                "left_control"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "y",
                            "modifiers": [
                                "left_command",
                                "left_shift"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
