{
    "title": "Win-keys \u00b7 45 \u00b7 IDEs: left Alt+digit tool windows, AltGr+digit types characters",
    "rules": [
        {
            "description": "Left Option+0..9 => Ctrl+Shift+Option+Cmd+0..9 in IDEs (tool windows; keeps AltGr = right Option free to type | @ # |)",
            "manipulators": [
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.microsoft\\.VSCode$",
                                "^com\\.microsoft\\.VSCodeInsiders$",
                                "^com\\.vscodium$",
                                "^com\\.google\\.antigravity$",
                                "^com\\.google\\.antigravity-ide$",
                                "^com\\.exafunction\\.windsurf$",
                                "^com\\.todesktop\\.230313mzl4w4u92$",
                                "^com\\.jetbrains\\.",
                                "^dev\\.zed\\.Zed$"
                            ]
                        }
                    ],
                    "from": {
                        "key_code": "1",
                        "modifiers": {
                            "mandatory": [
                                "left_option"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "1",
                            "modifiers": [
                                "left_control",
                                "left_shift",
                                "left_option",
                                "left_command"
                            ]
                        }
                    ]
