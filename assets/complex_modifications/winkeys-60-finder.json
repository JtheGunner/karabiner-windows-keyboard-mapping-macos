{
  "title": "Win-keys \u00b7 60 \u00b7 Finder (F2 rename, Enter open)",
  "rules": [
    {
      "description": "Finder: F2 => Return (rename)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            }
          ],
          "from": {
            "key_code": "f2",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "finder_renaming",
                "value": 1
              }
            },
            {
              "key_code": "return_or_enter"
            }
          ]
        }
      ]
    },
    {
      "description": "Finder: Enter while renaming => Return (confirm rename)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_if",
              "name": "finder_renaming",
              "value": 1
            }
          ],
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter"
            },
            {
              "set_variable": {
                "name": "finder_renaming",
                "value": 0
              }
            }
          ]
        }
      ]
    },
    {
      "description": "Finder: Escape while renaming => Escape (cancel rename)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_if",
              "name": "finder_renaming",
              "value": 1
            }
          ],
          "from": {
            "key_code": "escape",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            },
            {
              "set_variable": {
                "name": "finder_renaming",
                "value": 0
              }
            }
          ]
        }
      ]
    },
    {
      "description": "Finder: Enter => Cmd+O (open selected item)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            }
          ],
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "o",
              "modifiers": [
                "left_command"
              ]
            }
          ]
        }
      ]
    }
  ]
}
