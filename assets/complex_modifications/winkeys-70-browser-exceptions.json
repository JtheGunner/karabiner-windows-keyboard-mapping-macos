{
  "title": "Win-keys \u00b7 70 \u00b7 Browser exceptions (F5, F12, Ctrl+H history, zoom)  [order before 10]",
  "rules": [
    {
      "description": "F5 / Ctrl+F5 => reload / hard-reload",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.beta$",
                "^com\\.google\\.Chrome\\.canary$",
                "^com\\.brave\\.Browser$",
                "^com\\.brave\\.Browser\\.beta$",
                "^com\\.brave\\.Browser\\.nightly$",
                "^company\\.thebrowser\\.Browser$",
                "^company\\.thebrowser\\.dia$",
                "^com\\.apple\\.Safari$",
                "^com\\.apple\\.SafariTechnologyPreview$",
                "^com\\.microsoft\\.edgemac$",
                "^org\\.mozilla\\.firefox$",
                "^org\\.mozilla\\.firefoxdeveloperedition$",
                "^org\\.mozilla\\.nightly$"
              ]
            }
          ],
          "from": {
            "key_code": "f5",
            "modifiers": {
              "mandatory": [],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "r",
              "modifiers": [
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.beta$",
                "^com\\.google\\.Chrome\\.canary$",
                "^com\\.brave\\.Browser$",
                "^com\\.brave\\.Browser\\.beta$",
                "^com\\.brave\\.Browser\\.nightly$",
                "^company\\.thebrowser\\.Browser$",
                "^company\\.thebrowser\\.dia$",
                "^com\\.apple\\.Safari$",
                "^com\\.apple\\.SafariTechnologyPreview$",
                "^com\\.microsoft\\.edgemac$",
                "^org\\.mozilla\\.firefox$",
                "^org\\.mozilla\\.firefoxdeveloperedition$",
                "^org\\.mozilla\\.nightly$"
              ]
            }
          ],
          "from": {
            "key_code": "f5",
            "modifiers": {
