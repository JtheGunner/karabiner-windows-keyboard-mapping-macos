{
  "title": "Win-keys \u00b7 40 \u00b7 Terminal clipboard / tabs (Ctrl+Shift+C/V/F, Ctrl+T/N), Ctrl/Shift+Insert",
  "rules": [
    {
      "description": "Ctrl+Shift+C/V/F/A => Cmd+C/V/F/A ; Ctrl+T/N (and +Shift) => Cmd+T/N  (terminals only; Ctrl+C stays SIGINT)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.mitchellh\\.ghostty$",
                "^dev\\.warp\\.Warp-Stable$",
                "^dev\\.warp\\.Warp$",
                "^org\\.tabby$",
                "^com\\.github\\.wez\\.wezterm$",
                "^net\\.kovidgoyal\\.kitty$",
                "^io\\.kitty$",
                "^org\\.alacritty$",
                "^io\\.alacritty$",
                "^co\\.zeit\\.hyper$",
                "^co\\.zeit\\.hyperterm$"
              ]
            }
          ],
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": [
                "left_control",
                "left_shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "c",
              "modifiers": [
                "left_command"
              ]
            }
          ]
        },
